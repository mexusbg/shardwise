{
  "name": "shardwise",
  "productName": "Shardwise",
  "desktopName": "shardwise.desktop",
  "version": "0.2.3",
  "description": "Cross-platform MongoDB GUI with a visual query builder",
  "main": "./out/main/index.js",
  "author": {
    "name": "mexus",
    "email": "mexus@fidweb.net"
  },
  "license": "MIT",
  "homepage": "https://github.com/mexusbg/shardwise",
  "repository": {
    "type": "git",
    "url": "https://github.com/mexusbg/shardwise.git"
  },
  "bugs": {
    "url": "https://github.com/mexusbg/shardwise/issues"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-smoke.mjs",
    "dist": "node scripts/fetch-tools.mts && node scripts/notices.mjs && electron-vite build && electron-builder --publish never",
    "dist:win": "node scripts/fetch-tools.mts win-x64 && node scripts/notices.mjs && electron-vite build && electron-builder --publish never --win --x64",
    "dist:mac": "node scripts/fetch-tools.mts mac-arm64 && node scripts/notices.mjs && electron-vite build && electron-builder --publish never --mac --arm64",
    "dist:linux": "node scripts/fetch-tools.mts linux-x64 && node scripts/notices.mjs && electron-vite build && electron-builder --publish never --linux --x64",
    "tools:fetch": "node scripts/fetch-tools.mts",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@aws-sdk/credential-providers": "^3.1154.0",
    "@codemirror/search": "^6.7.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "acorn": "^8.19.0",
    "bson": "^7.0.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "exceljs": "^4.4.0",
    "extract-zip": "^2.0.1",
    "kerberos": "^7.0.0",
    "mongodb": "^7.7.0",
    "mongodb-connection-string-url": "^7.0.2",
    "mongodb-query-parser": "^5.1.3",
    "mongoose": "^9.11.2",
    "mssql": "^12.7.10",
    "mysql2": "^3.24.6",
    "openai": "^6.49.0",
    "pg": "^8.23.1",
    "socks": "^2.8.10",
    "ssh2": "^1.17.0",
    "sucrase": "^3.35.1",
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.1",
    "@tanstack/react-virtual": "^3.14.21",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24"
  }
}
